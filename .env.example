# Techromz Play Standalone Environment Configuration

# Public Domain / Base URL of this Techromz Play deployment
# Example for local development: http://localhost:3000
# Example for production: https://play.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Parent Techromz Institute website URL (for course links and institute navigation)
NEXT_PUBLIC_INSTITUTE_URL=https://techromzit.com

# Analytics Configuration (Optional, defaults to false)
NEXT_PUBLIC_PLAY_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TPH2VY63MB

# Indexing Configuration (Set to true in production if indexing is desired)
PLAY_ALLOW_INDEXING=true

# Node Environment
NODE_ENV=production

# Server Port (Hostinger or local node runtime sets this)
PORT=3000
